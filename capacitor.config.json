{
  "appId": "com.aiio.app",
  "appName": "Aiio",
  "webDir": "www",
  "backgroundColor": "#F2F4F1",
  "loggingBehavior": "production",
  "android": {
    "backgroundColor": "#F2F4F1",
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "hidden": false
    }
  }
}
